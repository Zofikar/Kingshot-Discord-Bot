# Copy this file to .env beside the Compose file you use.
# Never commit .env. Blank IDs mean unset; use numeric Discord IDs, not names.
# This template targets this fork's Dockerfile + entrypoint.sh.
# For a direct Python launch, put the token in bot_token.txt instead; main.py
# does not read the Discord token from .env. Export optional core/OCR variables
# before launching Python (the extension loads .env only after core cogs load).

# REQUIRED for Docker startup unless bot_token.txt is already mounted.
DISCORD_BOT_TOKEN=
# Legacy alias DISCORD_TOKEN is also accepted; DISCORD_BOT_TOKEN takes priority.

# Required for MightPulse-backed /verify, /register, live NAP and nightly sync.
# Leave blank to run without those live-data extension features.
MIGHTPULSE_API_KEY=

# FIRST-RUN DEFAULTS: these settings seed db/settings.sqlite only once.
# Existing installs: use /admin_setting with the lowercase setting name.
# ALLOWED_KINGDOM_ID seeds whitelist_kids (a JSON list), not allowed_kingdom_id.
# Blank allows all kingdoms for verification; set a kingdom for automatic NAP
# candidate discovery, which uses the first kingdom in whitelist_kids.
ALLOWED_KINGDOM_ID=

# Optional verification, alliance leadership and council roles.
VERIFIED_ROLE_ID=
ROLE_R5_ID=
ROLE_R4_ID=
ROLE_COUNCIL_ID=
# Anchor role: generated alliance roles are ordered below this role by power.
# The bot needs permission to manage those roles and be above them in Discord.
ROLE_BOUND_TOP=

# Optional channels: NAP ranking, leaders' NAP tag list, and numeric player-ID
# registration messages respectively. Blank leaves that channel feature unset.
NAP_CHANNEL_ID=
LEADERS_NAP_POST_CHANNEL=
UNIFIED_ID_CHANNEL_ID=

# First-run NAP/council tuning (code defaults shown).
COUNCIL_TOP_ALLIANCES_COUNT=20
NAP_ALLIANCES_COUNT=10
NAP_CANDIDATE_MULTIPLIER=2.0
# Number of prior ranking snapshots that remain protected; 0 disables lookback.
NAP_SNAPSHOT_LOOKBACK_PROTECTED=0

# Live configuration: read at process startup; restart after changing these.
# MightPulse local cache durations in seconds.
PLAYER_CACHE_TTL_SECONDS=900
ALLIANCE_CACHE_TTL_SECONDS=3600

# Optional external OCR service. Blank uses local OCR unless overridden in the
# bot's External OCR Service UI; the saved UI setting takes precedence.
OCR_REMOTE_URL=
# Blank uses the built-in shared-service key. Set your private service's key
# when using a private endpoint; do not put a real secret in this example.
OCR_REMOTE_TOKEN=
OCR_REMOTE_TIMEOUT=60
# Blank auto-detects low-memory mode; 1 forces it on, 0 forces it off.
BOT_LOW_MEM=

# Advanced, normally unnecessary. Uncomment only when overriding defaults.
# BOT_BOOTSTRAP_URL is only used when startup files are missing.
# BOT_BOOTSTRAP_URL=https://github.com/Zofikar/Kingshot-Discord-Bot/archive/refs/heads/main.zip
# MALLOC_ARENA_MAX=2
# MALLOC_TRIM_THRESHOLD_=131072

# Not supported by this entrypoint: UPDATE, BETA, DEBUG (it always --no-update).
# Removed legacy options: ROLE_BOUND_BOTTOM, CALENDAR_EVENTS_CHANNEL_ID,
# NAP_LOOKBACK_CACHE_TTL_SECONDS. The current extension does not read them.
# Host/CI metadata (SERVER_DISK, DOCKER, CI, etc.) is not normal setup config.