*
!.gitignore
!LICENSE
!main.py
!README.md
!requirements.txt
!autoupdateinfo.txt
!cogs/
!cogs/*.py
!extension/
!extension/**
!MIGRATION.md
!FEATURE_PARITY.md
!.gitlab-ci.yml
!install/
!install/*
!fonts/
!fonts/*
!docker/
!docker/*
!.github/
!.github/workflows/
!.github/workflows/docker.yml
!tests/
!tests/**
!Dockerfile
!entrypoint.sh
!.dockerignore

# Never track Python bytecode — the `!extension/**` re-include above would
# otherwise pull __pycache__/*.pyc into version control.
__pycache__/
*.pyc